# ═══════════════════════════════════
#          Quasar Bot — Config
# ═══════════════════════════════════

# ═══════════════════════════════════
#   Mode de fonctionnement
# ═══════════════════════════════════
# Quasar sert deux publics avec le même code : les instances auto-hébergées, et
# l'instance publique opérée par Venacity (qui affiche en plus une vitrine de
# présentation). QUASAR_MODE décide de ce qui démarre et de ce que sert la racine.
#
#   bot    (DÉFAUT — auto-hébergement) : bot Discord + API + dashboard. '/' est la
#          page de connexion du dashboard, la vitrine n'est pas servie. C'est le
#          mode de toutes les installations auto-hébergées : si tu ne sais pas quoi
#          mettre ici, ne touche à rien.
#
#   site   (vitrine seule) : l'app démarre SANS se connecter à Discord — pas de bot,
#          pas de scheduler, pas d'auto-updater, pas de base SQLite, et DISCORD_TOKEN
#          n'est pas nécessaire. '/' sert la vitrine ; les URLs du dashboard répondent
#          une page « l'instance publique revient bientôt ». Utilisé par Venacity
#          quand l'instance publique est fermée.
#
#   public (instance publique complète) : bot + API + dashboard comme en mode bot,
#          MAIS '/' sert la vitrine et la page de connexion du dashboard passe sous
#          /dashboard. Pense à adapter CALLBACK_URL (voir plus bas).
#
# Une valeur inconnue est signalée au démarrage et retombe sur "bot".
#
# QUASAR_MODE ne décide QUE de ce qui démarre et de ce qui est servi. Il ne décide
# pas de ce que la vitrine propose aux visiteurs : c'est le rôle de
# PUBLIC_INSTANCE_OPEN, juste en dessous.
#QUASAR_MODE=bot

# ═══════════════════════════════════
#   Ouverture de l'instance publique
# ═══════════════════════════════════
# Cette variable ne concerne QUE l'affichage : elle décide si la vitrine propose,
# ou non, un bouton « Accéder au dashboard » aux visiteurs. Rien d'autre.
#
# Ce qu'elle NE fait PAS :
#   - elle ne démarre ni n'arrête le bot ;
#   - elle ne monte ni ne démonte la moindre route ;
#   - elle ne ferme PAS le dashboard. En mode public, /dashboard reste joignable
#     en tapant l'adresse directement, que le bouton soit affiché ou non. Pour
#     réellement fermer le dashboard, c'est le mode qu'il faut changer (site).
#
# Pourquoi elle existe : une instance publique peut avoir besoin de tourner en
# permanence (mode public, bot connecté) sans encore proposer son dashboard au
# public — le temps d'une mise en conformité, par exemple. Le mode et l'ouverture
# au public sont deux décisions distinctes, elles ont donc deux variables.
#
#   true   → le bouton est proposé sur la vitrine, mais UNIQUEMENT si
#            QUASAR_MODE=public (en mode site le dashboard n'existe pas : le
#            bouton mènerait à la page « bientôt de retour », un piège à clic).
#   sinon  → pas de bouton. La vitrine est exactement celle d'une instance fermée.
#
# DÉFAUT : false (fermé). Seule la valeur "true" ouvre le bouton ; toute autre
# valeur ("1", "oui", vide, absente) le laisse fermé — on ne devine jamais une
# intention d'ouverture. Sans intérêt en mode bot (pas de vitrine servie).
#PUBLIC_INSTANCE_OPEN=false

# Discord Bot (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Dashboard OAuth2
# Par défaut le dashboard n'écoute que sur la machine qui l'héberge (voir BIND_ADDRESS
# plus bas). Si tu l'ouvres au réseau, remplace localhost par l'IP de ton serveur.
# Ex: http://192.168.1.100:3000/callback
# L'IP s'affiche dans les logs au démarrage du bot.
# ⚠️  Cette URL doit aussi être ajoutée dans Developer Portal → OAuth2 → Redirects
#
# CALLBACK_URL doit pointer vers le chemin d'authentification de CETTE instance :
# l'URL publique par laquelle on la joint, suivie de /callback (qui redirige vers
# /auth/callback, la route réelle).
#   QUASAR_MODE=bot    → http://localhost:3000/callback
#   QUASAR_MODE=public → https://quasar.vena.city/callback
# En mode public, la racine est occupée par la vitrine et le dashboard vit sous
# /dashboard : c'est la page de connexion qui déménage, pas l'authentification.
# Les chemins /callback et /auth/* restent à la racine — c'est bien /callback
# qu'attend Discord dans ses Redirects OAuth2.
CALLBACK_URL=http://localhost:3000/callback

# Sécurité — Génère un secret aléatoire : openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_string

# Propriétaire de l'instance — ton identifiant Discord.
#
# Ce n'est pas « un administrateur de plus » : cette variable ouvre des fonctions qui
# portent sur l'INSTANCE ENTIÈRE, pas sur un serveur en particulier :
#   - statut et activité du bot ;
#   - suspension d'un serveur — couper Quasar sur ce serveur, sans supprimer ses
#     données ni retirer le bot ;
#   - compteur des serveurs connectés ;
#   - envoi d'une notification de violation de données, qui part en message privé à
#     TOUS les administrateurs de TOUS les serveurs connectés à ton instance.
#
# N'y mets que ton propre identifiant. Laissée vide, aucune de ces fonctions n'est
# accessible à personne : le refus par défaut est volontaire.
BOT_OWNER_ID=

# Server
PORT=3000

# Exposition du dashboard — RESTREINTE PAR DÉFAUT
# Le dashboard donne accès à toute la configuration du bot et aux données des serveurs.
# Il n'est donc joignable que depuis la machine qui l'héberge, sauf décision contraire.
#
# En Docker (cas de l'install par défaut) : c'est BIND_ADDRESS qui compte.
#   127.0.0.1 → dashboard accessible seulement sur la machine hôte
#   0.0.0.0   → dashboard exposé à tout le réseau (pense à un reverse proxy + HTTPS)
BIND_ADDRESS=127.0.0.1
#
# Hors Docker (node index.js directement) : c'est DASHBOARD_HOST qui compte.
# Mêmes valeurs. Ne pas y toucher en conteneur : le Dockerfile le force à 0.0.0.0,
# car il désigne l'interface interne au conteneur, pas son exposition.
#DASHBOARD_HOST=127.0.0.1

# ═══════════════════════════════════
#   Identité de l'instance (optionnel)
# ═══════════════════════════════════
# Quasar est distribué en auto-hébergement : chaque instance est opérée par une
# personne ou une organisation différente. Renseigner ces champs permet au dashboard
# de dire clairement qui héberge le service — et donc qui est responsable des données.
# Laissés vides, le dashboard indique simplement « la personne ou l'organisation qui
# l'a installée », sans nommer personne.
INSTANCE_OPERATOR_NAME=
INSTANCE_LEGAL_URL=

# Contrat de sous-traitance (RGPD article 28) — UNIQUEMENT en QUASAR_MODE=public.
#
# Dès qu'une instance est ouverte à des serveurs tiers, l'article 28 impose un contrat
# écrit entre l'hébergeur de l'instance (sous-traitant) et chaque administrateur qui y
# connecte son serveur (responsable de traitement). Quasar l'exige alors à la première
# connexion au dashboard, et trace qui a accepté quelle version.
#
# En mode `bot` (le défaut, auto-hébergement), aucun contrat n'est demandé : tu es seul
# opérateur de ton instance, tu n'as personne avec qui contracter.
#
# Cette variable pointe vers le TEXTE PUBLIC de ton contrat. Si tu ouvres ta propre
# instance publique, publie ton contrat et mets son URL ici — le contrat livré avec le
# code nomme Venacity comme sous-traitant, il ne vaut que pour son instance. Pense
# aussi à remplacer dashboard/legal/contrat.html (copie servie en repli) et les
# constantes de api/services/contract.js.
#
# Laissée vide : le contrat de l'instance Venacity. Seules les URL http(s) sont acceptées.
CONTRACT_PUBLIC_URL=

# Code source de CETTE instance. La licence AGPL-3.0 (article 13) impose de proposer
# le code réellement exécuté aux personnes qui utilisent le dashboard à distance.
# Si tu as modifié Quasar et que ton dashboard est accessible à d'autres, publie ton
# dépôt et mets son URL ici. Par défaut : le dépôt officiel.
INSTANCE_SOURCE_URL=

# ═══════════════════════════════════
#   Signalements
# ═══════════════════════════════════
# Deux natures de signalement, deux destinataires — voir bot/utils/reportRouting.js.
#
# 1. BUG DU LOGICIEL (/signaler bug) — concerne le code de Quasar. Part chez qui le
#    développe. Par défaut Venacity (https://sema.vena.city). Change cette valeur si
#    tu maintiens ton propre fork et veux recevoir les bugs toi-même.
#REPORT_RELAY_URL=https://sema.vena.city
#
# 2. ABUS D'USAGE (/signaler abus) — concerne l'exploitation de TON instance, pas le
#    code. VIDE PAR DÉFAUT, volontairement : sans configuration, aucun signalement
#    d'abus ne quitte ton instance, et la commande oriente l'utilisateur vers les
#    administrateurs du serveur et vers toi. Ne renseigne cette URL que si tu disposes
#    d'un point de collecte compatible (API publique de report).
ABUSE_REPORT_URL=
#
# Contact affiché à qui veut signaler un abus quand ABUSE_REPORT_URL est vide.
# Exemple : abuse@mondomaine.fr ou https://mondomaine.fr/contact
INSTANCE_ABUSE_CONTACT=

# ═══════════════════════════════════
#   Conservation des données
# ═══════════════════════════════════
# Délai de grâce, en jours, avant que les données d'un serveur soient supprimées
# après le retrait du bot. Réinviter le bot avant l'échéance annule la suppression.
# 0 = suppression immédiate. Défaut : 7.
#GUILD_PURGE_GRACE_DAYS=7
#
# La durée de conservation des sanctions se règle par serveur depuis le dashboard
# (Modération → Conservation des sanctions), défaut 12 mois : c'est l'administrateur
# de chaque serveur qui en est responsable, pas l'hébergeur de l'instance.

# ═══════════════════════════════════
#   Vitrine (modes site et public uniquement)
# ═══════════════════════════════════
# Ces deux variables ne servent qu'à la vitrine : en mode bot (auto-hébergement),
# elles ne sont jamais lues.
#
# Base URL du Design System VNCT, que la vitrine charge à distance. Laisser vide
# en production : https://design.vena.city par défaut. En dev, pointer vers
# https://dev-design.vena.city.
#VNCT_DS_BASE_URL=
#
# Webhook Discord de repli pour les signalements envoyés depuis le bouton flottant
# de la vitrine. Le chemin nominal passe par Sema (REPORT_RELAY_URL) ; ce webhook
# n'est utilisé que si Sema est injoignable. Vide = repli désactivé (le relais
# répond alors 503, sans rien perdre du chemin nominal).
#FEEDBACK_WEBHOOK_URL=
